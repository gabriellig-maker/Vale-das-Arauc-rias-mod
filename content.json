      "Fields": {
        "Goby": {
          "DisplayName": "Cambeva",
          "Description": "Pequeno bagre de corpo alongado e bigodes que vive nos riachos do Sul do Brasil. Esconde-se entre as pedras, perto das corredeiras."
        },
        "SeaJelly": {
          "DisplayName": "Geleia de Florianópolis",
          "Description": "Uma substância gelatinosa rara, encontrada ao pescar no mar. Lembra as águas do litoral de Florianópolis."
        },
        "RiverJelly": {
          "DisplayName": "Geleia do Açude",
          "Description": "Uma substância gelatinosa rara de água doce, encontrada ao pescar em rios, lagoas e açudes."
        },
        "CaveJelly": {
          "DisplayName": "Geleia da Grota",
          "Description": "Uma geleia rara dos lagos subterrâneos. Dizem que ela treme no ritmo de 'Do Fundo da Grota', como se Baitaca estivesse cantando lá embaixo."
        }
      }
    },
